{
  "$schema": "https://raw.githubusercontent.com/CastilloA27/Voltage-Plugins/main/themes/theme.schema.json",
  "id": "jackpot",
  "name": "Jackpot",
  "version": "2.0.0",
  "author": "Voltage",
  "extends": "voltage",
  "appearance": "dark",
  "description": "A video slot: a 5 x 3 symbol screen with the cover in the middle, reels that spin on every new song, paylines, coins and JACKPOT when you like a song.",
  "fonts": [
    {
      "family": "Bungee",
      "src": "assets/bungee/Bungee-Regular.ttf"
    }
  ],
  "tokens": {
    "color.bg": "#07061a",
    "color.text": "#eef4ff",
    "color.text-dim": "#a9b8e0",
    "color.text-strong": "#ffffff",
    "color.surface": "rgba(20, 16, 48, .8)",
    "color.border": "rgba(0, 210, 255, .35)",
    "color.brand": "#00d2ff",
    "color.on-accent": "#04101f",
    "color.knob": "#9ff0ff",
    "color.select-bg": "#24174d",
    "surface.menu": "#120d26",
    "surface.pop": "#141030",
    "surface.tip": "#120d26",
    "effect.blur": "10px",
    "effect.glow-size": "16px",
    "effect.glow-alpha": "55%",
    "accent.album-mix": "0.2",
    "shape.radius": "18px"
  },
  "accent": {
    "mode": "fixed",
    "color": "#00d2ff"
  },
  "parts": {
    "progress": {
      "variant": "blocks"
    },
    "art": {
      "variant": "cover"
    }
  },
  "supports": {
    "background": [
      "cover",
      "gradient",
      "black"
    ]
  },
  "strings": {
    "player.next": "Spin",
    "player.prev": "Back",
    "player.shuffle": "Roll",
    "library.liked": "Jackpots",
    "empty.queue": "Insert a song to play",
    "nowplaying.idle": "Insert a song",
    "nav.stats": "Win history",
    "explore.fromLiked": "Your jackpots",
    "note.liked": "BIG WIN!",
    "menu.playNow": "Spin it",
    "menu.playNext": "Spin next"
  },
  "sounds": {
    "skip": "assets/reel.wav",
    "play": "assets/bell.wav",
    "like": "assets/coin.wav",
    "click": "assets/tick.wav",
    "navigate": "assets/tick.wav"
  },
  "overlay": true,
  "plugin": "reels",
  "layout": {
    "nowplaying": {
      "areas": [
        "back info info info info info video",
        "l r1 r2 art r4 r5 r",
        "prog prog prog prog prog prog prog",
        "ctl ctl ctl ctl ctl vol vol"
      ],
      "columns": "1fr repeat(5, 180px) 1fr",
      "rows": "auto 540px 48px 96px",
      "place": {
        "back": "back",
        "info": "info",
        "video": "video",
        "l": "spacer",
        "r": "spacer",
        "r1": "slot:reel1",
        "r2": "slot:reel2",
        "art": "art",
        "r4": "slot:reel4",
        "r5": "slot:reel5",
        "prog": "progress",
        "ctl": "player",
        "vol": "volume"
      },
      "below": {
        "1100px": {
          "areas": [
            "back info video",
            "r2 art r4",
            "prog prog prog",
            "ctl ctl vol"
          ],
          "columns": "1fr 180px 1fr",
          "rows": "auto 540px 48px 96px",
          "place": {
            "back": "back",
            "info": "info",
            "video": "video",
            "r2": "slot:reel2",
            "art": "art",
            "r4": "slot:reel4",
            "prog": "progress",
            "ctl": "player",
            "vol": "volume"
          }
        }
      }
    },
    "mini": {
      "areas": [
        "art meta ctl"
      ],
      "columns": "64px 1fr auto",
      "place": {
        "art": "art",
        "meta": "info",
        "ctl": "player"
      }
    }
  },
  "css": "theme.css"
}
