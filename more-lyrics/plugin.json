{
  "id": "more-lyrics",
  "name": "More lyrics sources",
  "version": "1.2.0",
  "author": "Voltage",
  "description": "Adds Kugou and QQ Music as lyrics sources: word-by-word timed lyrics for many Japanese, Chinese and Korean songs (and plenty of others). They show up in the lyrics view's source menu and Voltage picks one automatically when it's the best.",
  "main": "main.js",
  "permissions": {
    "capabilities": [
      "lyrics.provider",
      "net.fetch"
    ],
    "hosts": [
      "https://mobiles.kugou.com/api/v3/search",
      "https://krcs.kugou.com/search",
      "https://lyrics.kugou.com/download",
      "https://c.y.qq.com/soso/fcgi-bin/client_search_cp",
      "https://c.y.qq.com/qqmusic/fcgi-bin/lyric_download.fcg"
    ]
  },
  "minVoltage": "1.6.0",
  "provides": {
    "commands": [
      {
        "id": "loose",
        "label": "Search Kugou more loosely for this song",
        "song": true
      }
    ]
  },
  "settings": [
    {
      "key": "kugou",
      "type": "switch",
      "label": "Kugou",
      "default": true
    },
    {
      "key": "qq",
      "type": "switch",
      "label": "QQ Music",
      "default": true
    }
  ]
}
